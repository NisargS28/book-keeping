# Supabase Configuration (Client-side)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy projects may instead use NEXT_PUBLIC_SUPABASE_ANON_KEY.

# NOTE ON ENCRYPTION:
# There is NO global encryption key environment variable.
# All data encryption keys are generated randomly per user on the client,
# wrapped with user passphrase / recovery secrets, and held in browser memory only.

# Twilio WhatsApp Integration (Optional / Out of scope for encrypted ledger)
# Get these from: https://www.twilio.com/console
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Application URL (required for Twilio signature validation)
# Local development: Use ngrok URL (e.g., https://abc123.ngrok.io)
# Production: Use your domain (e.g., https://yourdomain.com)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
